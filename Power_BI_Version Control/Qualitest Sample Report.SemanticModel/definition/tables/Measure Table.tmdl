table 'Measure Table'
	lineageTag: 22122c0d-1160-4b1a-bb41-0cf0c0806790

	/// Percentage of tests passed out of total tests executed. Calculated as Total Passed Tests divided by Total Tests.
	measure 'Pass Rate %' = DIVIDE ( [Total Passed Tests], [Total Tests], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e3ef0775-e7e0-46a0-b83a-fbf50379eb4c

	/// Total number of tests that did not pass. Calculated as the difference between Total Tests and Passed Tests.
	measure 'Failed Tests' = SUM(QualitestData[TotalTests]) - SUM(QualitestData[PassedTests])
		formatString: 0
		lineageTag: e3bd176a-4293-477b-9e6d-b0b05ce2e442

	/// Average number of days from project start date to end date across all projects in the current filter context.
	measure 'Avg Project Duration Days' =
			
			AVERAGEX(
			    QualitestData,
			    DATEDIFF(QualitestData[StartDate], QualitestData[EndDate], DAY)
			)
		lineageTag: 6b5b7183-82c9-41f1-9821-752664cf0b6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of projects with zero critical defects and a pass rate of 90% or higher, representing fully successful project deliveries.
	measure 'Project Success Count' = ```
			
			SUMX(
			    QualitestData,
			    IF(
			        QualitestData[CriticalDefects] = 0 && 
			        DIVIDE(QualitestData[PassedTests], QualitestData[TotalTests], 0) >= 0.9,
			        1,
			        0
			    )
			)
			```
		formatString: 0
		lineageTag: 69c40bb3-a8e8-4ebe-9abf-e951e6b72ee2

	/// Distinct count of projects started quarter-to-date (QTD) based on the project start date.
	measure 'Projects This Quarter' =
			
			CALCULATE(
			    DISTINCTCOUNT(QualitestData[ProjectID]),
			    DATESQTD(QualitestData[StartDate])
			)
		formatString: 0
		lineageTag: fae3058d-8921-4d8d-8fd0-ad640fd3a2a1

	/// Distinct count of projects active month-to-date (MTD) based on the Calendar date table.
	measure 'Projects This Month' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(QualitestData[ProjectID]),
			    DATESMTD('Calendar'[Date])
			)
			
			```
		formatString: 0
		lineageTag: 23209c37-2a96-463a-84fc-6b766d025556

	/// Distinct count of all unique projects (by Project ID) within the current filter context.
	measure 'Total Projects' = ```
			
			DISTINCTCOUNT(QualitestData[ProjectID])
			
			
			```
		formatString: #,0
		lineageTag: db68c464-672c-49fc-8d19-dbf73e16c031

	/// Month-to-date pass rate calculated as the ratio of passed tests to total tests using the Calendar date table.
	measure 'Pass Rate' =
			
			VAR TotalTests =
			    CALCULATE( SUM(QualitestData[TotalTests]), DATESMTD('Calendar'[Date]) )
			VAR TotalPassed =
			    CALCULATE( SUM(QualitestData[PassedTests]), DATESMTD('Calendar'[Date]) )
			RETURN
			DIVIDE(TotalPassed, TotalTests, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e12f227-1e5a-4d72-8909-13c9da68353e

	/// Alias for the Pass Rate measure. Returns the month-to-date pass rate formatted as a percentage with one decimal place.
	measure 'Avg Pass Rate %' = [Pass Rate]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ac73f0bd-2606-4410-998a-750064b7b458

	/// Average customer satisfaction score (scale 1–5) for projects month-to-date based on the Calendar date table.
	measure 'Avg CSAT' =
			
			CALCULATE(
			    AVERAGE( QualitestData[CustomerSatisfaction (1–5)] ),
			    DATESMTD( 'Calendar'[Date] )
			)
		lineageTag: f2e9eba8-3f7a-4269-af01-df73b446911b


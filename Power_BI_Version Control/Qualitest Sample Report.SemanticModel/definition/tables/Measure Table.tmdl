	/// Estimated financial exposure from critical defects, calculated as total critical defects × $1,000 cost per defect. Used as a proxy for quality-driven revenue risk.
	measure 'Revenue Impact' =
			
			VAR CostPerDefect = 1000  // Assume $1000 per critical defect
			VAR TotalCriticalDefects = SUM(QualitestData[CriticalDefects])
			RETURN
			TotalCriticalDefects * CostPerDefect
		formatString: 0
		lineageTag: 68eb2dbd-51dd-4b6a-99f7-661957876820

	/// Composite efficiency score out of 100: 30 points from automation rate, 50 points from pass rate, and 20 points from CSAT (normalized to 0–1 scale).
	measure 'Efficiency Score' =
			
			VAR AutomationBonus = [Avg Automation Rate] * 30
			VAR QualityScore = [Pass Rate] * 50
			VAR SatisfactionScore = DIVIDE([Avg CSAT], 5, 0) * 20
			RETURN
			ROUND(AutomationBonus + QualityScore + SatisfactionScore, 1)
		lineageTag: 6f9dfad6-7759-4434-9270-c766f47f9cfe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average number of tests executed per project, calculated as Total Tests divided by Total Projects.
	measure 'Avg Tests per Project' =
			
			DIVIDE([Total Tests], [Total Projects], 0)
		lineageTag: 4c8e150d-3d54-4e71-be6b-882bd470aa4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Proxy return-on-investment metric for automation, combining automation rate × pass rate plus a CSAT quality bonus (CSAT × 0.2).
	measure 'Automation ROI' =
			
			VAR AutomationBenefit = [Avg Automation Rate] * [Pass Rate]
			VAR QualityBenefit = [Avg CSAT] * 0.2
			RETURN
			ROUND(AutomationBenefit + QualityBenefit, 2)
		lineageTag: 92bde5d7-d260-4cc6-a558-3f359ea6fa2c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Formatted label combining the pass rate percentage and project count (e.g., '97.5% (142)'). Used as a data label or tooltip in visuals.
	measure 'Pass Rate Label' =
			

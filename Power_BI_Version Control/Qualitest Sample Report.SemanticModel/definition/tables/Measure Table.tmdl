	/// Average pass rate over the rolling 3-month window ending at the latest project start date in the current context.
	measure 'Rolling 3M Avg Pass Rate' = ```
			
			VAR Last3Months = 
			    DATESINPERIOD(
			        QualitestData[StartDate],
			        MAX(QualitestData[StartDate]),
			        -3,
			        MONTH
			    )
			RETURN
			CALCULATE([Pass Rate], Last3Months)

	/// Returns a hex color code based on the current Pass Rate: green (#27AE60) if ≥ 90%, orange (#F39C12) if ≥ 80%, or red (#E74C3C) if below 80%. Used for conditional formatting in visuals.
	measure 'Pass Rate Color' =
			
			SWITCH(
			    TRUE(),
			    [Pass Rate] >= 0.90, "#27AE60",  // Green
			    [Pass Rate] >= 0.80, "#F39C12",  // Orange
			    "#E74C3C"  // Red
			)
		lineageTag: 363aab74-6c7e-40b8-be72-6a15dbc564a5

	/// Returns a hex color code based on Avg CSAT: green (#27AE60) if ≥ 4.0, orange (#F39C12) if ≥ 3.5, or red (#E74C3C) if below 3.5. Used for conditional formatting in visuals.
	measure 'Satisfaction Color' =
			
			SWITCH(
			    TRUE(),
			    [Avg CSAT] >= 4.0, "#27AE60",  // Green
			    [Avg CSAT] >= 3.5, "#F39C12",  // Orange
			    "#E74C3C"  // Red

		lineageTag: a2821ea7-d00c-4983-bd5a-f0fa3498bbd0

	/// Returns the Pass Rate only for the top 5 clients ranked by pass rate (descending). Returns BLANK() for all other clients, enabling focused visual comparisons.
	measure 'Top 5 Clients Pass Rate' = ```
			
			VAR CurrentClient = SELECTEDVALUE(QualitestData[ClientName])
			VAR ClientRank = 
			    RANKX(
			        ALL(QualitestData[ClientName]),
			        CALCULATE([Pass Rate]),
			        ,
			        DESC
			    )
			RETURN
			IF(ClientRank <= 5, [Pass Rate], BLANK())
			```
		lineageTag: 516c763e-b9bc-4be9-9f48-7103cf020ef8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Returns the CSAT score only for the bottom 5 clients ranked by satisfaction (ascending). Returns BLANK() for all other clients, highlighting the lowest-performing accounts.
	measure 'Bottom 5 Clients Satisfaction' = ```
			
			VAR CurrentClient = SELECTEDVALUE(QualitestData[ClientName])
			VAR ClientRank = 
			    RANKX(
			        ALL(QualitestData[ClientName]),
			        CALCULATE([Avg CSAT]),
			        ,
			        ASC
			    )
			RETURN

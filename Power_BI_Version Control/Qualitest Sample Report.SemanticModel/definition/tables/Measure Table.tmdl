	/// Absolute change in pass rate between the current month and the prior month (Pass Rate minus Pass Rate PM).
	measure 'Pass Rate MoM Change' = [Pass Rate] - [Pass Rate PM]
		lineageTag: ebad9949-d955-46e8-8743-83c2e73a608b


	/// Proxy return-on-investment for automation, combining the product of automation rate and pass rate with a satisfaction bonus. Higher values indicate greater automation value.
	measure 'Automation ROI' =
			
			VAR AutomationBenefit = [Avg Automation Rate] * [Pass Rate]
			VAR QualityBenefit = [Avg CSAT] * 0.2
			RETURN
			ROUND(AutomationBenefit + QualityBenefit, 2)

	/// Marker measure for line charts using the disconnected MarkerMonth slicer. Returns project count only for the selected month, enabling a highlight dot to be placed on the chart.
	measure 'Projects Marker (Disconnected)' = ```
			
			VAR SelMonth =
			    COALESCE( SELECTEDVALUE(MarkerMonth[MonthName]),
			              MAX('Calendar'[MonthName]) )  -- default to latest visible month
			RETURN
			IF(
			    ISINSCOPE('Calendar'[MonthName]) &&
			    MAX('Calendar'[MonthName]) = SelMonth,
			    [Projects This Month]
			)
			
			
			```

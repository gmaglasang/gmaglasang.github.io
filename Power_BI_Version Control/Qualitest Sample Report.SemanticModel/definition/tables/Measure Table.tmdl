	/// Year-over-year growth in project count expressed as a percentage. Compares YTD Projects to the same period last year (PYSP Projects).
	measure 'YoY Growth %' =
			
			VAR CurrentPeriod = [YTD Projects]
			VAR PreviousPeriod = [PYSP Projects]
			RETURN
			DIVIDE(CurrentPeriod - PreviousPeriod, PreviousPeriod, 0) * 100

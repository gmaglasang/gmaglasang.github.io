	/// Returns the pass rate only for the top 5 clients ranked by pass rate (descending). Returns BLANK for all other clients, enabling targeted visuals highlighting top performers.
	measure 'Top 5 Clients Pass Rate' = ```
			
			VAR CurrentClient = SELECTEDVALUE(QualitestData[ClientName])
			VAR ClientRank = 
			    RANKX(
			        ALL(QualitestData[ClientName]),
			        CALCULATE([Pass Rate]),
			        ,
			        DESC
			    )
			RETURN
			IF(ClientRank <= 5, [Pass Rate], BLANK())

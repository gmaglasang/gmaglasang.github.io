table 'Measure Table'
	lineageTag: 22122c0d-1160-4b1a-bb41-0cf0c0806790

	/// Percentage of tests that passed, calculated as Total Passed Tests divided by Total Tests. Core quality metric for the selected period.
	measure 'Pass Rate %' = DIVIDE ( [Total Passed Tests], [Total Tests], 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e3ef0775-e7e0-46a0-b83a-fbf50379eb4c

	/// Total number of failed tests, calculated as the difference between Total Tests and Passed Tests.
	measure 'Failed Tests' = SUM(QualitestData[TotalTests]) - SUM(QualitestData[PassedTests])
		formatString: 0
		lineageTag: e3bd176a-4293-477b-9e6d-b0b05ce2e442

	/// Average number of days from project start to end date across all projects in the current filter context.
	measure 'Avg Project Duration Days' =
			
			AVERAGEX(
			    QualitestData,
			    DATEDIFF(QualitestData[StartDate], QualitestData[EndDate], DAY)
			)
		lineageTag: 6b5b7183-82c9-41f1-9821-752664cf0b6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of projects meeting strict success criteria: zero critical defects and a pass rate of at least 90%.
	measure 'Project Success Count' = ```
			
			SUMX(
			    QualitestData,
			    IF(
			        QualitestData[CriticalDefects] = 0 && 
			        DIVIDE(QualitestData[PassedTests], QualitestData[TotalTests], 0) >= 0.9,
			        1,
			        0
			    )
			)
			```
		formatString: 0
		lineageTag: 69c40bb3-a8e8-4ebe-9abf-e951e6b72ee2

	/// Distinct count of projects started in the current quarter (quarter-to-date using project start date).
	measure 'Projects This Quarter' =
			
			CALCULATE(
			    DISTINCTCOUNT(QualitestData[ProjectID]),
			    DATESQTD(QualitestData[StartDate])
			)
		formatString: 0
		lineageTag: fae3058d-8921-4d8d-8fd0-ad640fd3a2a1

	/// Distinct count of projects started in the current month (month-to-date using the Calendar table).
	measure 'Projects This Month' = ```
			
			CALCULATE(
			    DISTINCTCOUNT(QualitestData[ProjectID]),
			    DATESMTD('Calendar'[Date])
			)
			
			```
		formatString: 0
		lineageTag: 23209c37-2a96-463a-84fc-6b766d025556

	/// Distinct count of all projects in the current filter context based on Project ID.
	measure 'Total Projects' = ```
			
			DISTINCTCOUNT(QualitestData[ProjectID])
			
			
			```
		formatString: #,0
		lineageTag: db68c464-672c-49fc-8d19-dbf73e16c031

	/// Month-to-date pass rate: ratio of passed tests to total tests for the current month using the Calendar table.
	measure 'Pass Rate' =
			
			VAR TotalTests =
			    CALCULATE( SUM(QualitestData[TotalTests]), DATESMTD('Calendar'[Date]) )
			VAR TotalPassed =
			    CALCULATE( SUM(QualitestData[PassedTests]), DATESMTD('Calendar'[Date]) )
			RETURN
			DIVIDE(TotalPassed, TotalTests, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e12f227-1e5a-4d72-8909-13c9da68353e

	/// Alias for Pass Rate (MTD). Returns the month-to-date pass rate as a percentage.
	measure 'Avg Pass Rate %' = [Pass Rate]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ac73f0bd-2606-4410-998a-750064b7b458

	/// Average customer satisfaction score (scale 1–5) for the current month-to-date period.
	measure 'Avg CSAT' =
			
			CALCULATE(
			    AVERAGE( QualitestData[CustomerSatisfaction (1–5)] ),
			    DATESMTD( 'Calendar'[Date] )
			)
		lineageTag: f2e9eba8-3f7a-4269-af01-df73b446911b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average automation rate expressed as a decimal (0–1), derived from the AutomationRate column which is stored as a percentage.
	measure 'Avg Automation Rate %' = ```
			DIVIDE( AVERAGE(QualitestData[AutomationRate (%)]), 100 )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed4f86ef-37cc-4fa8-a1cd-cc9bad6f7e08

	/// Weighted average defect rate per 1,000 tests, weighted by the number of tests in each row to ensure accuracy across projects of different sizes.
	measure 'Defects per 1000' =
			
			VAR TotalTests = SUM(QualitestData[TotalTests])
			VAR WeightedDefects = SUMX(QualitestData, QualitestData[DefectsPer1000] * QualitestData[TotalTests])
			RETURN
			DIVIDE(WeightedDefects, TotalTests, 0)
		lineageTag: 8e7863b0-cfdd-4005-976b-20a4a0b62772

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average on-time delivery rate as a decimal (0–1), derived from the OnTimeDelivery column which is stored as a percentage.
	measure 'Ontime Delivery %' = ```
			
			DIVIDE( AVERAGE( QualitestData[OnTimeDelivery (%)] ), 100 )
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e0c92a51-d251-4a50-8a19-186f3cfce908

	/// Sum of all tests executed across all projects in the current filter context.
	measure 'Total Tests' = SUM(QualitestData[TotalTests])
		formatString: #,0
		lineageTag: 7dd6d94f-78a6-4feb-af53-8fe6c80d3144

	/// Sum of all tests that passed across all projects in the current filter context.
	measure 'Total Passed Tests' = SUM(QualitestData[PassedTests])
		formatString: #,0
		lineageTag: 618633e9-3057-45a0-8d1c-923dd6b99342

	/// Sum of critical defects found across all projects in the current filter context.
	measure 'Total Critical Defects' = SUM(QualitestData[CriticalDefects])
		formatString: #,0
		lineageTag: abab3264-76d5-41bd-886d-e4c95a464077

	/// Composite quality score (max ~10 points): 4 points from pass rate, up to 6 points from CSAT (score × 1.5), minus up to 2 points penalty for high defect rates (capped at 50 defects/1000).
	measure 'Quality Score' =
			
			VAR PassRateScore = [Pass Rate] * 4  // Max 4 points
			VAR SatisfactionScore = [Avg CSAT] * 1.5  // Max 6 points (4.0 * 1.5 = 6)
			VAR DefectPenalty = MIN(1, DIVIDE([Defects per 1000], 50, 0)) * 2  // Max 2 point penalty
			RETURN
			ROUND(PassRateScore + SatisfactionScore - DefectPenalty, 2)
		lineageTag: 28178ca1-7878-4e62-8fb1-278130b8359d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Proportion of projects deemed successful at row level: zero critical defects and a pass rate ≥ 85% per row. Note: this is a row-level calculation, not project-aggregated.
	measure 'Project Success Rate' = ```
			VAR SuccessfulProjects = SUMX( QualitestData, IF( QualitestData[CriticalDefects] = 0 && DIVIDE(QualitestData[PassedTests], QualitestData[TotalTests], 0) >= 0.85, 1, 0 ) ) VAR TotalProjects = DISTINCTCOUNT(QualitestData[ProjectID]) RETURN DIVIDE(SuccessfulProjects, TotalProjects, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4856a832-4a34-49d1-b277-23cad41f9166

	/// Percentage of unique projects that are successful, where success is defined as ≤7 critical defects and a pass rate ≥ 95% when aggregated to the project level.
	measure 'Project Success Rate %' = ```
			
			VAR Proj =
			    SUMMARIZE(
			        QualitestData, QualitestData[ProjectID],
			        "Crit", SUM ( QualitestData[CriticalDefects] ),
			        "Pass", DIVIDE( SUM(QualitestData[PassedTests]), SUM(QualitestData[TotalTests]), 0 )
			    )
			VAR Success =
			    COUNTROWS ( FILTER ( Proj, [Crit] <= 7 && [Pass] >= 0.95 ) )
			RETURN
			DIVIDE ( Success, COUNTROWS(Proj), 0 )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b26df309-db06-488a-bc2c-db6a576db105

	/// Difference between the current context pass rate and the industry-wide average pass rate, keeping only the industry dimension constant. Positive values indicate above-industry performance.
	measure 'Pass Rate vs Industry Avg' = ```
			
			VAR CurrentPassRate = [Pass Rate]
			VAR IndustryAverage = 
			    CALCULATE(
			        [Pass Rate],
			        ALLEXCEPT(QualitestData, QualitestData[Industry])
			    )
			RETURN
			CurrentPassRate - IndustryAverage
			```
		lineageTag: d81d8f30-2040-400d-afa9-6e56988a5d71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Difference between the current context CSAT and the regional average CSAT, keeping only the region constant. Positive values indicate above-average satisfaction for the region.
	measure 'Satisfaction vs Region Avg' = ```
			
			VAR CurrentSatisfaction = [Avg CSAT]
			VAR RegionAverage = 
			    CALCULATE(
			        [Avg CSAT],
			        ALLEXCEPT(QualitestData, QualitestData[Region])
			    )
			RETURN
			CurrentSatisfaction - RegionAverage
			```
		lineageTag: 831de9e9-0246-4c80-94fa-516120397cc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Rank of each industry by average automation rate (descending), where rank 1 indicates the highest automation rate across all industries.
	measure 'Automation Rate Rank' =
			
			RANKX(
			    ALL(QualitestData[Industry]),
			    CALCULATE([Avg Automation Rate]),
			    ,
			    DESC
			)
		formatString: 0
		lineageTag: 27e38bbe-8963-4385-b887-8d437e750c40

	/// Difference between the selected industry Quality Score and the overall Quality Score across all data. Positive values indicate the industry outperforms the company average.
	measure 'Industry vs Overall Performance' =
			
			VAR IndustryScore = [Quality Score]
			VAR OverallScore = CALCULATE([Quality Score], ALL(QualitestData))
			RETURN
			IndustryScore - OverallScore
		lineageTag: ba28cae4-90b0-4e45-afb7-19b795265aa3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Pass rate for the same period one month prior (previous month), used as the baseline for month-over-month comparisons.
	measure 'Pass Rate PM' =
			
			CALCULATE(
			    [Pass Rate],
			    DATEADD(QualitestData[StartDate], -1, MONTH)
			)
		lineageTag: d02260c6-87ed-4d2d-a78e-271670c88067

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Absolute change in pass rate compared to the previous month (current pass rate minus previous month pass rate).
	measure 'Pass Rate MoM Change' = [Pass Rate] - [Pass Rate PM]
		lineageTag: ebad9949-d955-46e8-8743-83c2e73a608b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Percentage change in pass rate compared to the previous month, expressed as a percentage value (e.g., 2 = 2% improvement).
	measure 'Pass Rate MoM Change %' =
			
			DIVIDE([Pass Rate MoM Change], [Pass Rate PM], 0) * 100
		lineageTag: 95f9a298-7138-4852-9444-12a4fb3376ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Pass rate calculated over a rolling 3-month window ending at the latest project start date visible in context.
	measure 'Rolling 3M Avg Pass Rate' = ```
			
			VAR Last3Months = 
			    DATESINPERIOD(
			        QualitestData[StartDate],
			        MAX(QualitestData[StartDate]),
			        -3,
			        MONTH
			    )
			RETURN
			CALCULATE([Pass Rate], Last3Months)
			```
		lineageTag: 25d31ffc-bbf0-484f-8658-0bd114e42877

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cumulative count of distinct projects from the start of the calendar year through the current date.
	measure 'YTD Projects' =
			
			CALCULATE(
			    [Total Projects],
			    DATESYTD(QualitestData[StartDate])
			)
		formatString: 0
		lineageTag: 57197ca0-779e-4761-b99c-35bf65893e24

	/// Distinct project count for the same period in the prior year (Prior Year Same Period), used as the denominator in YoY growth calculations.
	measure 'PYSP Projects' =
			
			CALCULATE(
			    [Total Projects],
			    SAMEPERIODLASTYEAR(QualitestData[StartDate])
			)
		formatString: 0
		lineageTag: 2eb5298c-e1b5-4a80-91b4-a186613f9a19

	/// Year-over-year growth rate in project count: (YTD Projects − Prior Year Same Period) ÷ Prior Year Same Period × 100.
	measure 'YoY Growth %' =
			
			VAR CurrentPeriod = [YTD Projects]
			VAR PreviousPeriod = [PYSP Projects]
			RETURN
			DIVIDE(CurrentPeriod - PreviousPeriod, PreviousPeriod, 0) * 100
		lineageTag: e32f1f74-7e08-4c7e-b49e-9672c177fb87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Conditional formatting color for Pass Rate: green (#27AE60) if ≥90%, orange (#F39C12) if ≥80%, red (#E74C3C) if below 80%.
	measure 'Pass Rate Color' =
			
			SWITCH(
			    TRUE(),
			    [Pass Rate] >= 0.90, "#27AE60",  // Green
			    [Pass Rate] >= 0.80, "#F39C12",  // Orange
			    "#E74C3C"  // Red
			)
		lineageTag: 363aab74-6c7e-40b8-be72-6a15dbc564a5

	/// Conditional formatting color for CSAT score: green (#27AE60) if ≥4.0, orange (#F39C12) if ≥3.5, red (#E74C3C) if below 3.5.
	measure 'Satisfaction Color' =
			
			SWITCH(
			    TRUE(),
			    [Avg CSAT] >= 4.0, "#27AE60",  // Green
			    [Avg CSAT] >= 3.5, "#F39C12",  // Orange
			    "#E74C3C"  // Red
			)
		lineageTag: 84f21946-067b-4081-8d34-12cb6a1e5e78

	/// Conditional formatting color for Defects per 1000: green (#27AE60) if ≤20, orange (#F39C12) if ≤40, red (#E74C3C) if above 40.
	measure 'Defect Color' =
			
			SWITCH(
			    TRUE(),
			    [Defects per 1000] <= 20, "#27AE60",  // Green
			    [Defects per 1000] <= 40, "#F39C12",  // Orange
			    "#E74C3C"  // Red
			)
		lineageTag: dff07434-d4d6-4ee0-a5d8-258b24d17323

	/// Conditional formatting color for Automation Rate: green (#27AE60) if ≥70%, orange (#F39C12) if ≥50%, red (#E74C3C) if below 50%.
	measure 'Automation Color' =
			
			SWITCH(
			    TRUE(),
			    [Avg Automation Rate] >= 70, "#27AE60",  // Green

	/// Count of projects with more than 10 critical defects. Flags projects requiring urgent quality attention.
	measure 'Critical Projects' = ```
			
			CALCULATE(
			    [Total Projects],
			    QualitestData[CriticalDefects] > 10
			)
			
			```
		formatString: 0

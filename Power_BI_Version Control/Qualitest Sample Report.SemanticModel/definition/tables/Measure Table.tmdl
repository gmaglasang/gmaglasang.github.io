	/// Sum of critical defects recorded across all projects in the current filter context.
	measure 'Total Critical Defects' = SUM(QualitestData[CriticalDefects])
		formatString: #,0
		lineageTag: abab3264-76d5-41bd-886d-e4c95a464077

	/// Composite quality score combining pass rate (up to 4 pts), customer satisfaction (up to 6 pts), and a defect penalty (up to -2 pts). Higher scores indicate better quality.
	measure 'Quality Score' =
			
			VAR PassRateScore = [Pass Rate] * 4  // Max 4 points
			VAR SatisfactionScore = [Avg CSAT] * 1.5  // Max 6 points (4.0 * 1.5 = 6)
			VAR DefectPenalty = MIN(1, DIVIDE([Defects per 1000], 50, 0)) * 2  // Max 2 point penalty
			RETURN
			ROUND(PassRateScore + SatisfactionScore - DefectPenalty, 2)
		lineageTag: 28178ca1-7878-4e62-8fb1-278130b8359d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Ratio of projects with zero critical defects and a pass rate ≥ 85% to total distinct projects. Represents an overall project success benchmark.
	measure 'Project Success Rate' = ```
			VAR SuccessfulProjects = SUMX( QualitestData, IF( QualitestData[CriticalDefects] = 0 && DIVIDE(QualitestData[PassedTests], QualitestData[TotalTests], 0) >= 0.85, 1, 0 ) ) VAR TotalProjects = DISTINCTCOUNT(QualitestData[ProjectID]) RETURN DIVIDE(SuccessfulProjects, TotalProjects, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 4856a832-4a34-49d1-b277-23cad41f9166

	/// Stricter project success rate requiring ≤ 7 critical defects and a pass rate ≥ 95% at the project level, calculated using a project-level summary.
	measure 'Project Success Rate %' = ```
			
			VAR Proj =
			    SUMMARIZE(
			        QualitestData, QualitestData[ProjectID],
			        "Crit", SUM ( QualitestData[CriticalDefects] ),
			        "Pass", DIVIDE( SUM(QualitestData[PassedTests]), SUM(QualitestData[TotalTests]), 0 )
			    )
			VAR Success =
			    COUNTROWS ( FILTER ( Proj, [Crit] <= 7 && [Pass] >= 0.95 ) )
			RETURN
			DIVIDE ( Success, COUNTROWS(Proj), 0 )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b26df309-db06-488a-bc2c-db6a576db105

	/// Difference between the current context pass rate and the industry-wide average pass rate. Positive values indicate above-industry performance.
	measure 'Pass Rate vs Industry Avg' = ```
			
			VAR CurrentPassRate = [Pass Rate]
			VAR IndustryAverage = 
			    CALCULATE(
			        [Pass Rate],
			        ALLEXCEPT(QualitestData, QualitestData[Industry])
			    )
			RETURN
			CurrentPassRate - IndustryAverage
			```
		lineageTag: d81d8f30-2040-400d-afa9-6e56988a5d71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Difference between the current context average CSAT and the regional average CSAT. Positive values indicate above-regional satisfaction.
	measure 'Satisfaction vs Region Avg' = ```
			
			VAR CurrentSatisfaction = [Avg CSAT]
			VAR RegionAverage = 
			    CALCULATE(
			        [Avg CSAT],
			        ALLEXCEPT(QualitestData, QualitestData[Region])
			    )
			RETURN
			CurrentSatisfaction - RegionAverage
			```
		lineageTag: 831de9e9-0246-4c80-94fa-516120397cc9


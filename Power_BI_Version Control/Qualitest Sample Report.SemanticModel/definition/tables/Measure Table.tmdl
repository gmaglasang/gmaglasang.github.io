	/// Pass rate for the prior month (one month back from the current date context), used as the baseline for month-over-month comparisons.
	measure 'Pass Rate PM' =
			
			CALCULATE(
			    [Pass Rate],
			    DATEADD(QualitestData[StartDate], -1, MONTH)
			)
		lineageTag: d02260c6-87ed-4d2d-a78e-271670c88067


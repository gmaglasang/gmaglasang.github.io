	/// Weighted average defect density per 1,000 tests for the current month-to-date period, weighting each project's rate by its test volume.
	measure 'Defects/1000 (This Month)' =
			
			VAR TotalTests_MTD =
			    CALCULATE( SUM(QualitestData[TotalTests]), DATESMTD('Calendar'[Date]) )
			VAR WeightedDefects_MTD =
			    CALCULATE(
			        SUMX(QualitestData, QualitestData[DefectsPer1000] * QualitestData[TotalTests]),
			        DATESMTD('Calendar'[Date])
			    )
			RETURN DIVIDE(WeightedDefects_MTD, TotalTests_MTD, 0)
		lineageTag: 0c5f1edb-357a-4ec7-b0ba-f3905623f815

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Weighted average defect density per 1,000 tests for the prior month's month-to-date period, used as the baseline for defect density MoM comparison.
	measure 'Defects/1000 (Last Month)' =
			
			VAR TotalTests_LM =
			    CALCULATE( SUM(QualitestData[TotalTests]),
			               DATESMTD( DATEADD('Calendar'[Date], -1, MONTH) ) )
			VAR WeightedDefects_LM =
			    CALCULATE(
			        SUMX(QualitestData, QualitestData[DefectsPer1000] * QualitestData[TotalTests]),
			        DATESMTD( DATEADD('Calendar'[Date], -1, MONTH) )
			    )
			RETURN DIVIDE(WeightedDefects_LM, TotalTests_LM, 0)
		lineageTag: 3595682c-5fc9-4588-bc69-228a4c74823e

		annotation PBI_FormatHint = {"isGeneralNumber":true}


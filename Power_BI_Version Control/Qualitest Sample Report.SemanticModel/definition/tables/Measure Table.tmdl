	/// Returns the name of the region with the highest Quality Score. Used to surface the top-performing region as a text insight.
	measure 'Best Region' = ```
			
			VAR BestRegionName = 
			    TOPN(
			        1,
			        SUMMARIZE(QualitestData, QualitestData[Region]),
			        CALCULATE([Quality Score])
			    )
			RETURN
			CONCATENATEX(BestRegionName, QualitestData[Region])
			```
		lineageTag: ff3c7dcd-1d2f-46aa-ab6d-2cd992eb72b2

	/// Returns the name of the service type with the lowest Pass Rate. Used to surface the underperforming service category as a text insight.
	measure 'Worst Service Type' = ```
			
			VAR WorstService = 
			    TOPN(
			        1,
			        SUMMARIZE(QualitestData, QualitestData[ServiceType]),
			        CALCULATE([Pass Rate]),
			        ASC
			    )
			RETURN
			CONCATENATEX(WorstService, QualitestData[ServiceType])
			```
		lineageTag: cbfcef8c-fa6b-4af7-bac1-5bb78d82148f

	/// Count of projects where the automation rate is 70% or higher. Measures adoption of high-automation practices.
	measure 'High Automation Projects' =
			
			CALCULATE(

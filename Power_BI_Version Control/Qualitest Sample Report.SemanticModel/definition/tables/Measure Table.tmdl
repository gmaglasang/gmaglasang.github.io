	/// Percentage of projects with more than 10 critical defects out of all projects.
	measure 'Critical Projects %' =
			
			DIVIDE([Critical Projects], [Total Projects], 0) * 100
		lineageTag: 6a272c32-7476-4b32-8e84-be083c346e74


	/// Month-to-date pass rate for the prior month (one month back from the current Calendar date), used as the baseline for month-over-month pass rate comparison.
	measure 'Pass Rate (Last Month)' =
			
			VAR TotalTests =
			    CALCULATE( SUM(QualitestData[TotalTests]),
			               DATESMTD( DATEADD('Calendar'[Date], -1, MONTH) ) )
			VAR TotalPassed =
			    CALCULATE( SUM(QualitestData[PassedTests]),
			               DATESMTD( DATEADD('Calendar'[Date], -1, MONTH) ) )
			RETURN
			DIVIDE(TotalPassed, TotalTests, 0)

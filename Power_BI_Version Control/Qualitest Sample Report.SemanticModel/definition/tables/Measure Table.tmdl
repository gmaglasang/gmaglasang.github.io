	/// Count of distinct project IDs visible in the current filter context. Used as a denominator for context-aware success rate calculations.
	measure 'Projects in Context' = ```
			COUNTROWS ( VALUES ( QualitestData[ProjectID] ) )
			
			
			
			```
		lineageTag: 1912fde4-accb-4780-8fe1-b9c1e42eb37c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Count of projects meeting strict success criteria in the current context: ≤5 critical defects and a pass rate ≥95% at the project level.
	measure 'Successful Projects in Context' =
			
			SUMX (
			    VALUES ( QualitestData[ProjectID] ),
			    VAR crit = CALCULATE ( SUM ( QualitestData[CriticalDefects] ) )
			    VAR passRate = CALCULATE ( DIVIDE ( SUM ( QualitestData[PassedTests] ),
			                                        SUM ( QualitestData[TotalTests] ), 0 ) )
			    RETURN IF ( crit <= 5 && passRate >= 0.95, 1, 0 )
			)
		lineageTag: 46e827bd-b9bb-4c93-8867-6265637346a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Context-aware project success rate: successful projects in context divided by total projects in context. Uses COALESCE to return 0 instead of BLANK.
	measure 'Project Success Rate1 %' =
			
			VAR Proj = VALUES(QualitestData[ProjectID])
			VAR Succ = [Successful Projects in Context]
			VAR Tot  = [Projects in Context]
			RETURN COALESCE( DIVIDE( Succ, Tot ), 0 )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 764122b1-5d58-420f-8787-763c515dd4d7

	/// Proportion of critical defects relative to all defects found. Measures the severity mix of the defect portfolio.
	measure 'Critical Defect Rate %' = ```
			
			DIVIDE( SUM(QualitestData[CriticalDefects]),
			        SUM(QualitestData[DefectsFound]), 0 )
			
			
			```
		lineageTag: ef3bb533-2caa-47b9-95ab-d315fa8ec1f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}


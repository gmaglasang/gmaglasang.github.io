	/// Average automation rate across all projects expressed as a percentage. Divides the raw automation rate field (stored as 0–100) by 100.
	measure 'Avg Automation Rate %' = ```
			DIVIDE( AVERAGE(QualitestData[AutomationRate (%)]), 100 )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ed4f86ef-37cc-4fa8-a1cd-cc9bad6f7e08

	/// Weighted average defect density per 1,000 tests. Weights each project's defect rate by its test volume to produce an accurate aggregate.
	measure 'Defects per 1000' =
			
			VAR TotalTests = SUM(QualitestData[TotalTests])
			VAR WeightedDefects = SUMX(QualitestData, QualitestData[DefectsPer1000] * QualitestData[TotalTests])
			RETURN
			DIVIDE(WeightedDefects, TotalTests, 0)
		lineageTag: 8e7863b0-cfdd-4005-976b-20a4a0b62772

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average on-time delivery rate across all projects, expressed as a percentage. Converts the raw 0–100 field to a decimal ratio.
	measure 'Ontime Delivery %' = ```
			
			DIVIDE( AVERAGE( QualitestData[OnTimeDelivery (%)] ), 100 )
			
			
			```
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e0c92a51-d251-4a50-8a19-186f3cfce908

	/// Sum of total tests executed across all projects in the current filter context.
	measure 'Total Tests' = SUM(QualitestData[TotalTests])
		formatString: #,0
		lineageTag: 7dd6d94f-78a6-4feb-af53-8fe6c80d3144

	/// Sum of tests that passed across all projects in the current filter context.
	measure 'Total Passed Tests' = SUM(QualitestData[PassedTests])
		formatString: #,0

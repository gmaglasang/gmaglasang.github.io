	/// Difference between the industry segment's quality score and the overall quality score across all data. Highlights which industries perform above or below average.
	measure 'Industry vs Overall Performance' =
			
			VAR IndustryScore = [Quality Score]
			VAR OverallScore = CALCULATE([Quality Score], ALL(QualitestData))
			RETURN
			IndustryScore - OverallScore
		lineageTag: ba28cae4-90b0-4e45-afb7-19b795265aa3

